# Copy to .env and fill in real values. NEVER commit .env.
PORT=5000

# Postgres connection string. URL-encode special chars in the password (@ -> %40).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string

CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Gmail account + app password (https://myaccount.google.com/apppasswords)
EMAIL_USER=you@gmail.com
EMAIL_PASS=your_gmail_app_password
ADMIN_EMAIL=admin@example.com

# --- Stripe (https://dashboard.stripe.com/test/apikeys) ---
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen --forward-to localhost:5000/api/webhook` (dev) or dashboard (prod)
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Charge currency: mad | eur | usd
STRIPE_CURRENCY=mad
